{
    "name": "itzmekhokan/pressready",
    "description": "Pressready — scan a WordPress site's whole stack for what breaks on a target PHP/WP version, before you upgrade.",
    "type": "phpcodesniffer-standard",
    "keywords": ["wordpress", "phpcs", "phpcompatibility", "static-analysis", "upgrade", "compatibility", "deprecations"],
    "license": "GPL-2.0-or-later",
    "require": {
        "php": ">=7.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "bin": ["bin/pressready"],
    "autoload": {
        "psr-4": {
            "Pressready\\": "Pressready/"
        },
        "files": ["wp-cli.php"]
    },
    "extra": {
        "commands": ["pressready scan"]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpcsstandards/phpcsutils": true
        }
    }
}
