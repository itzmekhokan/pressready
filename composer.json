{
    "name": "itzmekhokan/pressready",
    "description": "Is your WordPress site ready for the next PHP or WordPress version? Scan the whole installed stack and find out before you upgrade.",
    "type": "phpcodesniffer-standard",
    "keywords": ["wordpress", "phpcs", "phpcompatibility", "static-analysis", "upgrade", "compatibility", "deprecations"],
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Khokan Sardar",
            "email": "itzmekhokan@gmail.com",
            "homepage": "https://github.com/itzmekhokan",
            "role": "Author"
        }
    ],
    "require": {
        "php": ">=7.4",
        "phpcompatibility/phpcompatibility-wp": "^2.1 || 3.0.0-alpha2",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0"
    },
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "3.0.0-alpha2"
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "bin": ["bin/pressready"],
    "autoload": {
        "psr-4": {
            "Pressready\\": "Pressready/"
        },
        "files": ["wp-cli.php"]
    },
    "extra": {
        "commands": ["pressready scan"]
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpcsstandards/phpcsutils": true
        }
    }
}
