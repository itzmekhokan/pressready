#!/usr/bin/env php
<?php
/**
 * Pressready — WordPress upgrade-readiness scanner.
 *
 * @copyright 2026 Khokan Sardar
 * @license   GPL-2.0-or-later
 * @link      https://github.com/itzmekhokan/pressready
 *
 * pressready — driver around the PHPCS Pressready + PHPCompatibility standards.
 *
 * Runs both engines in a single PHPCS pass over a path, then groups findings by
 * the owning plugin/theme (rather than by file) and prints one upgrade-readiness
 * report with a unified severity model:
 *
 *   - PHP removed-in-target  → FATAL  (the upgrade will break here)
 *   - PHP deprecated-in-target → notice (still runs; emits a PHP deprecation)
 *   - WP deprecated-in-target  → notice (still runs; tech debt / WP notice)
 *
 * This is the engine the future `wp … pressready` WP-CLI command will reuse.
 *
 * Usage:
 *   pressready [--php=8.4] [--wp=6.9] [--since=6.4] [--path=.] [--all]
 *              [--format=grouped|table|json|summary|github] [--fail-on=fatal|risky|deprecated]
 *              [--ignore-on=fatal|risky|deprecated] [--baseline[=file]] [--generate-baseline[=file]]
 *
 * At least one of --php or --wp is required.
 *
 * Baseline (adopt on a legacy site without drowning in pre-existing findings):
 *   pressready --php=8.4 --wp=6.9 --generate-baseline   # snapshot today's findings
 *   pressready --php=8.4 --wp=6.9 --baseline            # then only NEW findings show/fail
 *
 * Per-finding suppression also works via native PHPCS comments, e.g.
 *   create_function(...); // phpcs:ignore PHPCompatibility
 *
 * @package Pressready
 */

const PRESSREADY_BASELINE = '.pressready-baseline.json';

main( $argv );

/**
 * Entry point.
 *
 * @param string[] $argv CLI arguments.
 */
function main( array $argv ): void {
	// --help / -h: print usage and exit cleanly, before any target validation.
	if ( in_array( '--help', $argv, true ) || in_array( '-h', $argv, true ) ) {
		print_usage();
		exit( 0 );
	}

	$opts   = apply_config( parse_opts( $argv ) ); // CLI > .pressready.json > defaults.
	$php    = $opts['php'] ?? '';
	$wp     = $opts['wp'] ?? '';
	$since  = $opts['since'] ?? '';
	$format    = $opts['format'] ?? 'grouped';
	$ignore_on = $opts['ignore-on'] ?? '';

	// Package root that holds Pressready/ + the dataset + the bundled phpcs. When
	// running from the distributable .phar, the toolchain is extracted to a cache
	// dir (phpcs runs as a subprocess over real files, which phar:// can't be), and
	// $home points there; otherwise it's null and we use the source/vendor layout.
	$home = phar_runtime_dir();
	$pkg  = $home ?? dirname( __DIR__ );

	if ( '' === $php && '' === $wp ) {
		fwrite( STDERR, "error: specify at least one target — --php=<ver> and/or --wp=<ver>\n" );
		exit( 2 );
	}
	if ( '' !== $php && ! preg_match( '/^\d+(?:\.\d+)?(?:-\d+(?:\.\d+)?)?$/', $php ) ) {
		fwrite( STDERR, "error: --php must be a version or range, e.g. 8.4 or 8.1-8.4\n" );
		exit( 2 );
	}

	// Compatibility matrix (--matrix): one scan tells us, per axis, the highest
	// fatal-free version and the first break. Scanning at the ceiling of the
	// requested PHP span surfaces every removal up to it (each finding names the
	// version it was removed in), which the matrix then sweeps analytically — no
	// N re-tokenizations. $test_php is what we hand phpcs; $php stays the span.
	$matrix   = isset( $opts['matrix'] );
	$test_php = $php;
	if ( $matrix && '' !== $php ) {
		$php_grid = php_version_grid( $php );
		$test_php = $php_grid ? (string) end( $php_grid ) : $php;
	}

	// Dataset-version awareness: the WP side can only know about deprecations the
	// dataset was generated from. If --wp targets a newer release, results may be
	// incomplete — warn (to stderr, never the report stream) rather than imply a
	// clean bill of health from a stale dataset.
	if ( '' !== $wp ) {
		warn_if_dataset_stale( $wp, dataset_path( $pkg ) );
	}

	// Resolve one or more scan targets (repeated --path, comma lists, config
	// `paths: []`). Every target must exist; $root is their common base, used to
	// show paths relative to the scan in reports.
	$targets_in = resolve_scan_paths( $opts );
	$roots      = array();
	foreach ( $targets_in as $p ) {
		$rp = realpath( $p );
		if ( false === $rp ) {
			fwrite( STDERR, "error: --path does not exist: $p\n" );
			exit( 2 );
		}
		$roots[] = $rp;
	}
	$root = common_base( $roots );

	$phpcs = find_phpcs( $home );
	if ( null === $phpcs ) {
		fwrite( STDERR, "error: PHP_CodeSniffer not found (run `composer install`)\n" );
		exit( 2 );
	}

	// Assemble the standard list: WP side (Pressready) when --wp is given, PHP
	// side (PHPCompatibilityWP) when --php is given. Both run in one PHPCS pass.
	// In phar mode PHPCompatibilityWP is referenced by its extracted ruleset path
	// (not by registered name), so phpcs needs no installed_paths config.
	$standards = array();
	if ( '' !== $wp ) {
		$standards[] = $pkg . '/Pressready/ruleset.xml';
	}
	if ( '' !== $php ) {
		$standards[] = ( null !== $home )
			? $home . '/vendor/phpcompatibility/phpcompatibility-wp/PHPCompatibilityWP/ruleset.xml'
			: 'PHPCompatibilityWP';
	}

	// PHPCS appends a timing footer to stdout with --report=json, so write the
	// report to a temp file (clean JSON) and read it back.
	$report = tempnam( sys_get_temp_dir(), 'pressready-' );

	// Live progress: a large wp-content scan can take a while. phpcs's own -p
	// meter is unreliable (it only prints to a real TTY and stays silent through
	// any pipe/redirect), so pressready renders its own spinner instead while
	// phpcs runs in the background. Human output only (never JSON/github); auto
	// on a TTY, and overridable with PRESSREADY_PROGRESS=1|0 for pipes/tests.
	$human        = ! in_array( $format, array( 'json', 'github', 'sarif' ), true );
	$progress_env = getenv( 'PRESSREADY_PROGRESS' );
	$progress     = $human && function_exists( 'proc_open' ) && (
		'1' === $progress_env
		|| ( '0' !== $progress_env && function_exists( 'posix_isatty' ) && @posix_isatty( STDERR ) )
	);

	$args = array(
		'--standard=' . implode( ',', $standards ),
		'--report-json=' . $report,
		'--extensions=php',
	);

	// Parallelism: phpcs forks workers when ext-pcntl is present. ON by default
	// (auto = CPU cores) since enterprise stacks are large; --parallel=1 disables.
	$parallel = resolve_parallel( $opts );
	if ( $parallel > 1 ) {
		$args[] = '--parallel=' . $parallel;
	}

	// Incremental cache: opt-in via --cache[=file]. Re-scans only reprocess
	// changed files — a large-stack CI/dev win. Default cache lives in the temp dir.
	if ( isset( $opts['cache'] ) && ! isset( $opts['no-cache'] ) ) {
		$cache_file = ( '1' === $opts['cache'] ) ? sys_get_temp_dir() . '/pressready-cache.json' : $opts['cache'];
		$args[]     = '--cache=' . $cache_file;
	}

	// Path ignores: sensible built-in excludes (un-fixable vendored / generated
	// code) plus any user --ignore patterns, unless --no-default-ignore is given.
	$ignore = build_ignore_patterns( $opts );
	if ( '' !== $ignore ) {
		$args[] = '--ignore=' . $ignore;
	}

	if ( '' !== $test_php ) {
		// testVersion is the PHP version (or range) the site will run on;
		// PHPCompatibility reports everything removed/deprecated by then. In
		// matrix mode this is the ceiling of the requested span (see $test_php).
		$args[] = '--runtime-set';
		$args[] = 'testVersion';
		$args[] = $test_php;
	}
	foreach ( $roots as $r ) {
		$args[] = $r; // phpcs accepts multiple trailing paths in one pass.
	}

	// Run phpcs with an unlimited memory limit: tokenizing a large stack (or a
	// single big file) easily blows past PHP's default 128M, and phpcs then dies
	// mid-run *before* writing the JSON report — which used to surface only as an
	// opaque "no parseable output". The -d flag applies to the phpcs subprocess.
	$cmd = sprintf(
		'PRESSREADY_WP=%s PRESSREADY_WP_SINCE=%s %s %s',
		escapeshellarg( $wp ),
		escapeshellarg( $since ),
		escapeshellarg( PHP_BINARY ) . ' -d memory_limit=-1 ' . escapeshellarg( $phpcs ),
		implode( ' ', array_map( 'escapeshellarg', $args ) )
	);

	// The report goes to --report-json and phpcs stdout is discarded; stderr is
	// always captured to a file so a crash (e.g. out of memory) is reportable.
	$errfile = tempnam( sys_get_temp_dir(), 'pressready-err-' );
	if ( $progress ) {
		run_with_spinner( $cmd, $errfile );
	} else {
		shell_exec( $cmd . ' 1>/dev/null 2>' . escapeshellarg( $errfile ) );
	}
	$json   = is_file( $report ) ? file_get_contents( $report ) : '';
	$stderr = is_file( $errfile ) ? trim( (string) file_get_contents( $errfile ) ) : '';
	@unlink( $report );
	@unlink( $errfile );
	$data = json_decode( (string) $json, true );
	if ( ! is_array( $data ) || ! isset( $data['files'] ) ) {
		fwrite( STDERR, "error: scan produced no parseable output\n" );
		if ( '' !== $stderr ) {
			fwrite( STDERR, "phpcs reported:\n" . $stderr . "\n" );
		}
		exit( 2 );
	}

	// Scanning zero files must fail loudly, never pass vacuously: an empty file
	// map means the path/ignore filters matched nothing (a clean scan still lists
	// every checked file with empty messages). In CI this is a misconfiguration,
	// not a green light. (Exit 2 = usage/config error — see exit_code().)
	if ( empty( $data['files'] ) ) {
		fwrite( STDERR, "error: no files were scanned — check --path and --ignore filters\n" );
		if ( '' !== $stderr ) {
			fwrite( STDERR, "phpcs reported:\n" . $stderr . "\n" );
		}
		exit( 2 );
	}

	// Drop PHPCS tokenizer artefacts (Internal.*, e.g. NoCodeFound on a template
	// with no PHP). They are not compatibility findings and otherwise inflate the
	// deprecation totals — done before baseline/tally so every path is consistent.
	$data = strip_internal( $data );

	// Compatibility matrix: sweep the requested span from this single scan and
	// report the highest fatal-free version + first break, then exit. Honours
	// --fail-on against the fatals found across the span.
	if ( $matrix ) {
		render_matrix_output( $data, $root, $php, $wp, $format );
		exit( exit_code( tally( regroup( $data, $root ) ), $opts ) );
	}

	// Generate-baseline mode: snapshot the current findings and exit. Adopt the
	// tool on a legacy site without drowning — only NEW findings fail CI after.
	if ( isset( $opts['generate-baseline'] ) ) {
		$path = ( '1' === $opts['generate-baseline'] ) ? getcwd() . '/' . PRESSREADY_BASELINE : $opts['generate-baseline'];
		$n    = generate_baseline( $data, $root, $path );
		fwrite( STDOUT, "Wrote baseline ($n finding" . ( 1 === $n ? '' : 's' ) . ") to $path\n" );
		exit( 0 );
	}

	// Apply a baseline (--baseline[=path]) to suppress already-known findings.
	$suppressed = 0;
	if ( isset( $opts['baseline'] ) ) {
		$path = ( '1' === $opts['baseline'] ) ? getcwd() . '/' . PRESSREADY_BASELINE : $opts['baseline'];
		if ( ! is_file( $path ) ) {
			fwrite( STDERR, "error: baseline not found: $path\n" );
			exit( 2 );
		}
		list( $data, $suppressed ) = apply_baseline( $data, $root, $path );
	}

	// Strip findings of ignored severities before any rendering or tallying.
	if ( '' !== $ignore_on ) {
		$data = filter_data_ignored( $data, $ignore_on );
	}

	// GitHub Actions: emit workflow commands so findings annotate the PR inline.
	if ( 'github' === $format ) {
		render_github( $data );
		exit( exit_code( tally( regroup( $data, $root ) ), $opts ) );
	}

	// SARIF 2.1.0: feed code-scanning dashboards (GitHub Advanced Security, etc.).
	// Emitted losslessly from the flat phpcs structure (one result per finding).
	if ( 'sarif' === $format ) {
		render_sarif( $data, $root );
		exit( exit_code( tally( regroup( $data, $root ) ), $opts ) );
	}

	$grouped = regroup( $data, $root );

	// Component focus for large stacks: --only=<needle> narrows to matching
	// components; --top=N keeps the N worst (the list is already fatal-sorted).
	$total_components = count( $grouped );
	$grouped          = filter_components( $grouped, $opts['only'] ?? '', (int) ( $opts['top'] ?? 0 ) );
	$shown_components = count( $grouped );

	$tally               = tally( $grouped );
	$tally['suppressed'] = $suppressed;

	if ( 'json' === $format ) {
		echo json_encode(
			array( 'tally' => $tally, 'components' => $grouped ),
			JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES
		) . "\n";
		exit( exit_code( $tally, $opts ) );
	}

	$collapse = ! isset( $opts['no-collapse'] );
	$show_all = isset( $opts['all'] ) || isset( $opts['verbose'] );
	render( $grouped, $tally, $root, $php, $wp, $since, $format, $collapse, $total_components, $shown_components, $show_all );
	exit( exit_code( $tally, $opts ) );
}

/**
 * Print the usage / flag reference for --help / -h.
 *
 * @return void
 */
function print_usage(): void {
	echo <<<USAGE
Pressready — WordPress upgrade-readiness scanner.

Usage:
  pressready --php=<ver> [--wp=<ver>] [--path=<dir>]... [options]

At least one of --php or --wp is required.

Targets:
  --php=<ver>            Target PHP version or range, e.g. 8.4 or 8.1-8.4
  --wp=<ver>             Target WordPress version, e.g. 6.9
  --since=<ver>          With --wp: only what newly deprecates since this version
  --path=<dir>           Path to scan (repeatable; comma lists ok; default: cwd)

Output:
  --format=<fmt>         grouped (default) | table | summary | json | sarif | github
  --matrix               Grade the target span: highest safe version + first break
  --all                  List every deprecation inline (alias: --verbose)
  --no-collapse          One line per finding instead of collapsing duplicates

Gate:
  --fail-on=<lvl>        Exit non-zero at/above: fatal | risky | deprecated
  --ignore-on=<lvl>      Hide findings at/below: fatal | risky | deprecated

Scope & performance:
  --ignore=<patterns>    Extra comma-separated path patterns to skip
  --no-default-ignore    Disable the built-in ignores
  --only=<needle>        Only components whose name matches this substring
  --top=N                Only the N worst components
  --parallel[=N]         phpcs workers (default: on, auto CPU cores; =1 serial)
  --cache[=<file>]       Re-scans only reprocess changed files
  --no-cache             Force a fresh scan even when --cache is set

Baseline & config:
  --baseline[=<file>]            Suppress findings present in the snapshot
  --generate-baseline[=<file>]   Snapshot current findings and exit
  --config=<file>                Load defaults from a JSON config file
  -h, --help                     Show this help and exit

Exit codes:
  0  clean (or no --fail-on threshold tripped)
  1  findings at/above the --fail-on threshold
  2  usage/config error (bad flag, missing path, zero files scanned)

Docs: https://itzmekhokan.github.io/pressready/

USAGE;
}

/**
 * Resolve the list of scan-target paths from the merged options.
 *
 * Accepts repeated `--path` flags, comma-separated lists in a single `--path`,
 * and a config `paths: []` array (surfaced by apply_config under `paths`).
 * Values are de-duplicated, preserving order. Empty → caller defaults to cwd.
 *
 * @param array $opts Merged options.
 * @return string[] Path inputs (not yet realpath'd).
 */
function resolve_scan_paths( array $opts ): array {
	$raw = array();
	if ( isset( $opts['path'] ) ) {
		$raw = array_merge( $raw, is_array( $opts['path'] ) ? $opts['path'] : array( $opts['path'] ) );
	}
	if ( isset( $opts['paths'] ) && '1' !== $opts['paths'] ) {
		$raw = array_merge( $raw, is_array( $opts['paths'] ) ? $opts['paths'] : array( $opts['paths'] ) );
	}

	$paths = array();
	foreach ( $raw as $value ) {
		foreach ( explode( ',', (string) $value ) as $p ) {
			$p = trim( $p );
			if ( '' !== $p && ! in_array( $p, $paths, true ) ) {
				$paths[] = $p;
			}
		}
	}
	return empty( $paths ) ? array( getcwd() ) : $paths;
}

/**
 * Longest common directory prefix of a set of realpath'd scan roots.
 *
 * Used to show finding locations relative to the scan when several paths are
 * given. A single path is returned as-is (it may be a file, which the
 * relativisers already handle). A divergent set collapses to '/'.
 *
 * @param string[] $roots Absolute paths (each a file or directory).
 * @return string
 */
function common_base( array $roots ): string {
	if ( 1 === count( $roots ) ) {
		return $roots[0];
	}
	$segments = null;
	foreach ( $roots as $r ) {
		$dir   = is_dir( $r ) ? $r : dirname( $r );
		$parts = explode( '/', rtrim( $dir, '/' ) );
		if ( null === $segments ) {
			$segments = $parts;
			continue;
		}
		$common = array();
		foreach ( $segments as $i => $seg ) {
			if ( isset( $parts[ $i ] ) && $parts[ $i ] === $seg ) {
				$common[] = $seg;
			} else {
				break;
			}
		}
		$segments = $common;
	}
	$base = implode( '/', $segments ?? array() );
	return '' === $base ? '/' : $base;
}

/**
 * Remove PHPCS internal tokenizer artefacts (source `Internal.*`) from a report.
 *
 * The most common is `Internal.NoCodeFound`, emitted for template files with no
 * PHP (e.g. *.blade.php). These are parser notices, not compatibility findings,
 * so they must not land in the severity buckets. Per-file error/warning counts
 * are recomputed so downstream consumers stay consistent.
 *
 * @param array $data PHPCS JSON report.
 * @return array
 */
function strip_internal( array $data ): array {
	foreach ( $data['files'] as &$info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		$info['messages'] = array_values(
			array_filter(
				$info['messages'],
				static fn( $m ) => ! str_starts_with( (string) ( $m['source'] ?? '' ), 'Internal.' )
			)
		);
		$info['errors']   = count( array_filter( $info['messages'], static fn( $m ) => 'ERROR' === $m['type'] ) );
		$info['warnings'] = count( $info['messages'] ) - $info['errors'];
	}
	unset( $info );
	return $data;
}

/**
 * A baseline signature for a finding: stable across line moves / reordering.
 * Keyed by the sniff source plus the message with line numbers neutralised.
 *
 * @param array $m PHPCS message.
 * @return string
 */
function baseline_signature( array $m ): string {
	$msg = preg_replace( '/\bline \d+/', 'line N', $m['message'] ?? '' );
	return ( $m['source'] ?? '' ) . '|' . $msg;
}

/**
 * Repo-relative key for a finding's file in the baseline.
 *
 * Keys are made relative to the current working directory (the repo root in CI
 * and local runs alike) when the file lives under it, so a baseline is portable
 * regardless of whether --path was passed absolute or relative, or scoped to a
 * subdirectory. Files outside the cwd fall back to scan-root-relative.
 *
 * @param string $file Absolute file path.
 * @param string $root Scan root (common base of the scan targets).
 * @return string
 */
function baseline_relpath( string $file, string $root ): string {
	$cwd = rtrim( (string) getcwd(), '/' );
	if ( '' !== $cwd && str_starts_with( $file, $cwd . '/' ) ) {
		return ltrim( substr( $file, strlen( $cwd ) ), '/' );
	}
	return ltrim( str_replace( $root, '', $file ), '/' );
}

/**
 * Write a baseline snapshot of the current findings.
 *
 * Findings are keyed by scan-root-relative path → signature → count (PHPStan
 * style), so the baseline is portable and tolerant of line shifts.
 *
 * @param array  $data PHPCS JSON report.
 * @param string $root Scan root.
 * @param string $path Destination file.
 * @return int Number of findings recorded.
 */
function generate_baseline( array $data, string $root, string $path ): int {
	$findings = array();
	$total    = 0;
	foreach ( $data['files'] as $file => $info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		$rel = baseline_relpath( $file, $root );
		foreach ( $info['messages'] as $m ) {
			$sig = baseline_signature( $m );
			$findings[ $rel ][ $sig ] = ( $findings[ $rel ][ $sig ] ?? 0 ) + 1;
			++$total;
		}
	}
	$out = array(
		'schema'       => 1,
		'generated_at' => gmdate( 'c' ),
		'findings'     => $findings,
	);
	file_put_contents( $path, json_encode( $out, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES ) . "\n" );
	return $total;
}

/**
 * Subtract baselined findings from the report, leaving only new ones.
 *
 * @param array  $data PHPCS JSON report.
 * @param string $root Scan root.
 * @param string $path Baseline file.
 * @return array{0:array,1:int} [filtered data, number suppressed]
 */
function apply_baseline( array $data, string $root, string $path ): array {
	$baseline   = json_decode( (string) file_get_contents( $path ), true );
	$budget     = $baseline['findings'] ?? array();
	$suppressed = 0;

	foreach ( $data['files'] as $file => &$info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		$rel  = baseline_relpath( $file, $root );
		$kept = array();
		foreach ( $info['messages'] as $m ) {
			$sig = baseline_signature( $m );
			if ( ( $budget[ $rel ][ $sig ] ?? 0 ) > 0 ) {
				--$budget[ $rel ][ $sig ];
				++$suppressed;
				continue; // Known finding — drop it.
			}
			$kept[] = $m;
		}
		$info['messages'] = $kept;
		$info['errors']   = count( array_filter( $kept, static fn( $x ) => 'ERROR' === $x['type'] ) );
		$info['warnings'] = count( $kept ) - $info['errors'];
	}
	unset( $info );
	return array( $data, $suppressed );
}

/**
 * Emit GitHub Actions workflow commands (one annotation per finding).
 *
 * @param array $data PHPCS JSON report (possibly baseline-filtered).
 * @return void
 */
function render_github( array $data ): void {
	$cwd = getcwd();
	foreach ( $data['files'] as $file => $info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		$rel = ( $cwd && str_starts_with( $file, $cwd . '/' ) ) ? substr( $file, strlen( $cwd ) + 1 ) : $file;
		foreach ( $info['messages'] as $m ) {
			$sev = severity_of( $m );
			$cmd = 'fatal' === $sev ? 'error' : 'warning';
			printf(
				"::%s file=%s,line=%d,title=%s::%s\n",
				$cmd,
				gh_escape_prop( $rel ),
				$m['line'],
				gh_escape_prop( 'Pressready (' . $sev . ')' ),
				gh_escape_data( $m['message'] )
			);
		}
	}
}

/**
 * Escape a GitHub workflow-command message body.
 *
 * @param string $s Raw string.
 * @return string
 */
function gh_escape_data( string $s ): string {
	return strtr( $s, array( '%' => '%25', "\r" => '%0D', "\n" => '%0A' ) );
}

/**
 * Escape a GitHub workflow-command property value.
 *
 * @param string $s Raw string.
 * @return string
 */
function gh_escape_prop( string $s ): string {
	return strtr( $s, array( '%' => '%25', "\r" => '%0D', "\n" => '%0A', ',' => '%2C', ':' => '%3A' ) );
}

/**
 * Emit a SARIF 2.1.0 report so findings flow into code-scanning dashboards
 * (e.g. GitHub Advanced Security). One result per finding (lossless), with the
 * sniff source as ruleId and fatal→error / everything else→warning.
 *
 * @param array  $data PHPCS JSON report (possibly baseline/ignore-filtered).
 * @param string $root Scan root; result URIs are shown relative to it.
 * @return void
 */
function render_sarif( array $data, string $root ): void {
	$rules    = array();
	$rule_idx = array();
	$results  = array();

	foreach ( $data['files'] as $file => $info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		$rel = ltrim( str_replace( $root, '', $file ), '/' );
		foreach ( $info['messages'] as $m ) {
			$source = $m['source'] ?? 'Pressready';
			if ( ! isset( $rule_idx[ $source ] ) ) {
				$rule_idx[ $source ] = count( $rules );
				$rules[]             = array(
					'id'   => $source,
					'name' => $source,
				);
			}
			$results[] = array(
				'ruleId'    => $source,
				'ruleIndex' => $rule_idx[ $source ],
				'level'     => 'fatal' === severity_of( $m ) ? 'error' : 'warning',
				'message'   => array( 'text' => $m['message'] ),
				'locations' => array(
					array(
						'physicalLocation' => array(
							'artifactLocation' => array( 'uri' => $rel ),
							'region'           => array( 'startLine' => max( 1, (int) $m['line'] ) ),
						),
					),
				),
			);
		}
	}

	$sarif = array(
		'$schema' => 'https://json.schemastore.org/sarif-2.1.0.json',
		'version' => '2.1.0',
		'runs'    => array(
			array(
				'tool'    => array(
					'driver' => array(
						'name'           => 'Pressready',
						'informationUri' => 'https://github.com/itzmekhokan/pressready',
						'rules'          => $rules,
					),
				),
				'results' => $results,
			),
		),
	);
	echo json_encode( $sarif, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES ) . "\n";
}

/**
 * Narrow the grouped components for large stacks.
 *
 * --only=<needle> keeps components whose id or label contains the needle
 * (case-insensitive). --top=N keeps the N worst (the list is already sorted
 * fatal-first by regroup()). Both are no-ops when their argument is empty/zero.
 *
 * @param array  $components Grouped components (id-keyed, pre-sorted).
 * @param string $only       Case-insensitive substring filter, or ''.
 * @param int    $top        Keep at most this many components, or 0 for all.
 * @return array
 */
function filter_components( array $components, string $only, int $top ): array {
	if ( '' !== $only ) {
		$needle     = strtolower( $only );
		$components = array_filter(
			$components,
			static fn( $c, $id ) => false !== strpos( strtolower( (string) $id ), $needle )
				|| false !== strpos( strtolower( (string) $c['label'] ), $needle ),
			ARRAY_FILTER_USE_BOTH
		);
	}
	if ( $top > 0 && count( $components ) > $top ) {
		$components = array_slice( $components, 0, $top, true );
	}
	return $components;
}

/**
 * Tally findings by severity across all components.
 *
 * @param array $components Grouped findings.
 * @return array{fatal:int,risky:int,php:int,wp:int,total:int}
 */
function tally( array $components ): array {
	$t = array( 'fatal' => 0, 'risky' => 0, 'php' => 0, 'wp' => 0, 'total' => 0 );
	foreach ( $components as $c ) {
		foreach ( $c['files'] as $findings ) {
			foreach ( $findings as $f ) {
				++$t[ $f['severity'] ];
				++$t['total'];
			}
		}
	}
	return $t;
}

/**
 * Group PHPCS findings by owning plugin/theme component.
 *
 * @param array  $data PHPCS JSON report.
 * @param string $root Scan root.
 * @return array<string,array> Components keyed by id, each with label + findings.
 */
function regroup( array $data, string $root ): array {
	$components = array();
	foreach ( $data['files'] as $file => $info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		list( $id, $label, $base ) = component_of( $file, $root );
		if ( ! isset( $components[ $id ] ) ) {
			$components[ $id ] = array( 'label' => $label, 'dir' => $base, 'count' => 0, 'fatal' => 0, 'files' => array() );
		}
		$rel = ltrim( str_replace( $base, '', $file ), '/' );
		if ( '' === $rel ) {
			$rel = basename( $file ); // Single-file component (e.g. plugins/hello.php).
		}
		foreach ( $info['messages'] as $m ) {
			$severity = severity_of( $m );
			$components[ $id ]['files'][ $rel ][] = array(
				'line'     => $m['line'],
				'severity' => $severity,
				'source'   => $m['source'],
				'message'  => $m['message'],
			);
			++$components[ $id ]['count'];
			if ( 'fatal' === $severity ) {
				++$components[ $id ]['fatal'];
			}
		}
	}
	// Sort: most fatals first, then most findings.
	uasort(
		$components,
		static fn( $a, $b ) => ( $b['fatal'] <=> $a['fatal'] ) ?: ( $b['count'] <=> $a['count'] )
	);
	return $components;
}

/**
 * Classify a finding into the unified severity model.
 *
 *   fatal  PHP symbol/extension removed by the target version — a call to an
 *          undefined function/class, i.e. a real Fatal error on upgrade.
 *   risky  Other PHPCompatibility errors: behavioural / correctness changes
 *          (e.g. func_get_args() semantics since 7.0) that run but may misbehave.
 *   php    PHP feature deprecated (not yet removed) by the target version.
 *   wp     WordPress core API deprecated by the target WP version.
 *
 * Not every PHPCompatibility ERROR is a runtime fatal — only removals are. We
 * key the fatal verdict on the "removed since PHP" wording PHPCompatibility
 * emits precisely when a symbol is gone at the target version.
 *
 * @param array $m PHPCS message (has 'type', 'source', 'message').
 * @return string 'fatal' | 'risky' | 'php' | 'wp'.
 */
function severity_of( array $m ): string {
	if ( ! str_starts_with( $m['source'] ?? '', 'PHPCompatibility' ) ) {
		// Pressready (WP) sniff. A core symbol the target WP version has removed is
		// a real fatal on upgrade (undefined function/class); a still-shimmed
		// deprecation is tech debt → a warning.
		if ( false !== strpos( $m['message'] ?? '', 'removed since WordPress' ) ) {
			return 'fatal';
		}
		return 'wp';
	}
	if ( false !== strpos( $m['message'] ?? '', 'removed since PHP' ) ) {
		return 'fatal'; // Symbol is gone at the target version → undefined-symbol fatal.
	}
	if ( 'ERROR' === ( $m['type'] ?? '' ) ) {
		return 'risky'; // Behavioural/correctness change PHPCompatibility flags as an error.
	}
	return 'php'; // PHP deprecation warning.
}

/**
 * The discrete PHP versions Pressready sweeps for the compatibility matrix,
 * filtered to a requested range. PHP minors are not arithmetic across majors
 * (7.4 → 8.0), so the known sequence is enumerated explicitly. A range with no
 * known versions inside it falls back to its own bounds.
 *
 * @param string $php Version or range, e.g. "8.4" or "8.0-8.4".
 * @return string[] Ascending list of versions to grade.
 */
function php_version_grid( string $php ): array {
	static $known = array( '5.6', '7.0', '7.1', '7.2', '7.3', '7.4', '8.0', '8.1', '8.2', '8.3', '8.4', '8.5' );
	$parts = explode( '-', $php );
	$low   = $parts[0];
	$high  = $parts[1] ?? $parts[0];
	$grid  = array();
	foreach ( $known as $v ) {
		if ( version_compare( $v, $low, '>=' ) && version_compare( $v, $high, '<=' ) ) {
			$grid[] = $v;
		}
	}
	if ( empty( $grid ) ) {
		$grid = ( $low === $high ) ? array( $low ) : array( $low, $high );
	}
	return $grid;
}

/**
 * WordPress versions to grade for the matrix: the distinct removal thresholds in
 * scope, plus the target itself (so a clean target still shows one graded row).
 *
 * @param string   $wp      Target WP version.
 * @param string[] $thresholds WP removal-version thresholds collected from the scan.
 * @return string[] Ascending list of versions to grade.
 */
function wp_version_grid( string $wp, array $thresholds ): array {
	$set = array( $wp => true );
	foreach ( $thresholds as $t ) {
		if ( version_compare( $t, $wp, '<=' ) ) {
			$set[ $t ] = true;
		}
	}
	$grid = array_keys( $set );
	usort( $grid, 'version_compare' );
	return $grid;
}

/**
 * Collect the per-axis fatal removal-version thresholds from a scan. Every fatal
 * names the version it was removed in (PHP via PHPCompatibility, WP via the
 * Pressready sniff), so a finding that breaks at version T contributes T.
 *
 * @param array $data PHPCS JSON report (post strip_internal).
 * @return array{php:string[],wp:string[]}
 */
function matrix_thresholds( array $data ): array {
	$out = array( 'php' => array(), 'wp' => array() );
	foreach ( $data['files'] as $info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		foreach ( $info['messages'] as $m ) {
			if ( 'fatal' !== severity_of( $m ) ) {
				continue;
			}
			$msg = $m['message'] ?? '';
			if ( preg_match( '/removed since PHP (\d+(?:\.\d+)?)/', $msg, $mm ) ) {
				$out['php'][] = $mm[1];
			} elseif ( preg_match( '/removed since WordPress (\d+(?:\.\d+)?)/', $msg, $mm ) ) {
				$out['wp'][] = $mm[1];
			}
		}
	}
	return $out;
}

/**
 * Grade one axis: for each graded version, how many fatals have a removal
 * threshold at or below it (cumulative — a removal stays broken once it lands).
 * Yields the highest fatal-free version (`safe_through`) and the first breaking
 * one (`first_break`).
 *
 * @param string   $label      Axis label ("PHP" / "WP").
 * @param string[] $grid       Ascending graded versions.
 * @param string[] $thresholds Removal-version thresholds for this axis.
 * @return array{label:string,grid:array<int,array{version:string,fatals:int}>,safe_through:?string,first_break:?string}
 */
function axis_matrix( string $label, array $grid, array $thresholds ): array {
	$rows         = array();
	$safe_through = null;
	$first_break  = null;
	foreach ( $grid as $v ) {
		$n = 0;
		foreach ( $thresholds as $t ) {
			if ( version_compare( $t, $v, '<=' ) ) {
				++$n;
			}
		}
		$rows[] = array( 'version' => $v, 'fatals' => $n );
		if ( 0 === $n ) {
			$safe_through = $v;
		} elseif ( null === $first_break ) {
			$first_break = $v;
		}
	}
	return array(
		'label'        => $label,
		'grid'         => $rows,
		'safe_through' => $safe_through,
		'first_break'  => $first_break,
	);
}

/**
 * Build the per-axis matrix from a scan, then render it as human output or JSON.
 *
 * @param array  $data   PHPCS JSON report.
 * @param string $root   Scan root (shown in the header).
 * @param string $php    PHP target/range, or ''.
 * @param string $wp     WP target, or ''.
 * @param string $format Output format ('json' emits machine output; else human).
 * @return void
 */
function render_matrix_output( array $data, string $root, string $php, string $wp, string $format ): void {
	$thr  = matrix_thresholds( $data );
	$axes = array();
	if ( '' !== $php ) {
		$axes['php'] = axis_matrix( 'PHP', php_version_grid( $php ), $thr['php'] );
	}
	if ( '' !== $wp ) {
		$axes['wp'] = axis_matrix( 'WP', wp_version_grid( $wp, $thr['wp'] ), $thr['wp'] );
	}

	if ( 'json' === $format ) {
		echo json_encode( array( 'matrix' => $axes ), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES ) . "\n";
		return;
	}
	render_matrix( $axes, $root, $php, $wp );
}

/**
 * Human-readable compatibility matrix: a graded row per version, then a verdict
 * naming the highest safe version and the first break per axis.
 *
 * @param array  $axes Per-axis matrices from axis_matrix().
 * @param string $root Scan root.
 * @param string $php  PHP target/range, or ''.
 * @param string $wp   WP target, or ''.
 * @return void
 */
function render_matrix( array $axes, string $root, string $php, string $wp ): void {
	$targets = array();
	if ( '' !== $php ) {
		$targets[] = 'PHP ' . str_replace( '-', '–', $php );
	}
	if ( '' !== $wp ) {
		$targets[] = 'WP ' . $wp;
	}

	echo "\n";
	echo '  Pressready — compatibility matrix — ' . implode( ' + ', $targets ) . "\n";
	echo "  Scanned: $root\n\n";

	foreach ( $axes as $axis ) {
		echo '  ' . $axis['label'] . "\n";
		foreach ( $axis['grid'] as $row ) {
			$mark = 0 === $row['fatals']
				? ansi( '✓ clear', '0;32' )
				: ansi( sprintf( '✗ %d fatal%s', $row['fatals'], 1 === $row['fatals'] ? '' : 's' ), '1;31' );
			printf( "    %-6s %s\n", $row['version'], $mark );
		}
		echo "\n";
	}

	$safe   = array();
	$breaks = array();
	foreach ( $axes as $axis ) {
		if ( null !== $axis['safe_through'] ) {
			$safe[] = $axis['label'] . ' ' . $axis['safe_through'];
		}
		if ( null !== $axis['first_break'] ) {
			$n = 0;
			foreach ( $axis['grid'] as $row ) {
				if ( $row['version'] === $axis['first_break'] ) {
					$n = $row['fatals'];
				}
			}
			$breaks[] = sprintf( '%s %s (%d fatal%s)', $axis['label'], $axis['first_break'], $n, 1 === $n ? '' : 's' );
		}
	}

	if ( $safe ) {
		printf( "  %s\n", ansi( '✓ Safe through ' . implode( ' and ', $safe ) . '.', '0;32' ) );
	}
	if ( $breaks ) {
		printf( "  %s\n", ansi( '✗ First break: ' . implode( '; ', $breaks ) . '.', '1;31' ) );
	}
	echo "\n";
}

/**
 * Identify the plugin/theme/core component a file belongs to.
 *
 * Handles the real-world `wp-content` layout: multi-file plugins/themes (a slug
 * directory), single-file plugins (`plugins/hello.php`, `mu-plugins/loader.php`),
 * and WordPress core itself (`wp-admin`/`wp-includes`).
 *
 * @param string $file Absolute file path.
 * @param string $root Scan root.
 * @return array{0:string,1:string,2:string} [id, label, base-path-for-rel]
 */
function component_of( string $file, string $root ): array {
	// A plugin/theme/mu-plugin — the segment after plugins|mu-plugins|themes is
	// either a slug dir (multi-file) or a single file. Either way it's one component.
	if ( preg_match( '#^(.*/wp-content/(?:plugins|mu-plugins|themes)/[^/]+)#', $file, $m ) ) {
		$path = $m[1];
		return array( $path, header_label( $path ) ?? basename( $path ), $path );
	}
	// WordPress core itself — group everything under one "WordPress core" bucket,
	// with paths shown relative to the install root (e.g. wp-includes/foo.php).
	if ( preg_match( '#^(.*)/(wp-admin|wp-includes)/#', $file, $m ) ) {
		return array( '__core__', 'WordPress core', $m[1] );
	}
	// Otherwise treat the whole scan root as one component.
	return array( $root, header_label( $root ) ?? basename( $root ), $root );
}

/**
 * Read a "Plugin Name"/"Theme Name" (+ Version) header from a component, which
 * may be a directory (multi-file plugin/theme) or a single file (single-file
 * plugin / mu-plugin).
 *
 * @param string $path Component directory or file.
 * @return string|null Label like "bbPress 2.6.14", or null if no header found.
 */
function header_label( string $path ): ?string {
	if ( is_file( $path ) ) {
		$files = array( $path );
	} else {
		$files = glob( $path . '/*.php' ) ?: array();
		if ( is_file( $path . '/style.css' ) ) {
			$files[] = $path . '/style.css';
		}
	}
	foreach ( $files as $f ) {
		$head = (string) file_get_contents( $f, false, null, 0, 8192 );
		if ( preg_match( '/(?:Plugin|Theme)\s+Name:\s*(.+)/i', $head, $n ) ) {
			$label = trim( preg_replace( '#\s*\*/.*$#', '', $n[1] ) ); // Drop a trailing `*/` from inline-comment headers.
			if ( preg_match( '/Version:\s*([0-9][^\s*]*)/i', $head, $v ) ) {
				$label .= ' ' . trim( $v[1] );
			}
			return $label;
		}
	}
	return null;
}

/**
 * "Fix-first" block: list every fatal, then every risky finding with a
 * clickable path:line, so the actionable issues aren't buried under a long tail
 * of deprecations on a big scan. The full per-component breakdown still follows.
 *
 * @param array  $components Grouped findings (each has 'dir' + 'files').
 * @param string $root       Scan root; locations are shown relative to it.
 * @param bool   $collapse   Group identical messages (one line + a location list).
 */
function render_fix_first( array $components, string $root, bool $collapse = true ): void {
	$buckets = array( 'fatal' => array(), 'risky' => array() );
	foreach ( $components as $c ) {
		foreach ( $c['files'] as $rel => $findings ) {
			$full = rtrim( $c['dir'], '/' ) . '/' . $rel;
			$path = ltrim( str_replace( $root, '', $full ), '/' );
			if ( '' === $path ) {
				$path = $rel;
			}
			foreach ( $findings as $f ) {
				if ( isset( $buckets[ $f['severity'] ] ) ) {
					$msg = $collapse ? neutralize_lines( $f['message'] ) : $f['message'];
					$buckets[ $f['severity'] ][] = array(
						'loc' => $path . ':' . $f['line'],
						'msg' => compact_message( $msg ),
					);
				}
			}
		}
	}

	$sections = array(
		'fatal' => '  ' . ansi( '✗ FATAL (%d) — these break on upgrade; fix first:', '1;31' ),
		'risky' => '  ' . ansi( '⚠ RISKY (%d) — review the behaviour changes before upgrading:', '1;33' ),
	);
	foreach ( $sections as $sev => $heading ) {
		if ( empty( $buckets[ $sev ] ) ) {
			continue;
		}
		printf( "\n" . $heading . "\n", count( $buckets[ $sev ] ) );

		if ( ! $collapse ) {
			foreach ( $buckets[ $sev ] as $row ) {
				printf( "      %s  %s\n", $row['loc'], $row['msg'] );
			}
			continue;
		}

		// Collapse identical messages: print the message once with its locations.
		$by_msg = array();
		foreach ( $buckets[ $sev ] as $row ) {
			$by_msg[ $row['msg'] ][] = $row['loc'];
		}
		foreach ( $by_msg as $msg => $locs ) {
			if ( 1 === count( $locs ) ) {
				printf( "      %s  %s\n", $locs[0], $msg );
			} else {
				printf( "      %s  (×%d)\n        %s\n", $msg, count( $locs ), implode( ', ', $locs ) );
			}
		}
	}
}

/**
 * Render the human-readable report (grouped or summary).
 *
 * @param array  $components Grouped findings.
 * @param array  $tally      Severity tally.
 * @param string $root       Scan root.
 * @param string $php        Target PHP version.
 * @param string $wp         Target WP version.
 * @param string $since      Optional since version.
 * @param string $format     'grouped' or 'summary'.
 * @param bool   $collapse   Collapse repeated identical findings within a file.
 * @param int    $total_components Component count before --only/--top filtering.
 * @param int    $shown_components Component count after filtering.
 * @param bool   $show_all   List every deprecation inline (default hides them).
 */
function render( array $components, array $tally, string $root, string $php, string $wp, string $since, string $format, bool $collapse = true, int $total_components = 0, int $shown_components = 0, bool $show_all = false ): void {
	$total  = $tally['total'];
	$fatals = $tally['fatal'];

	$targets = array();
	if ( '' !== $php ) {
		$targets[] = 'PHP ' . str_replace( '-', '–', $php ); // en-dash for ranges, e.g. 8.1–8.4.
	}
	if ( '' !== $wp ) {
		$targets[] = $since ? "WP $since → $wp" : "WP $wp";
	}
	$scope = implode( ' + ', $targets );

	echo "\n";
	echo "  Pressready — WordPress upgrade readiness — target $scope\n";
	echo "  Scanned: $root\n";

	$suppressed_note = ! empty( $tally['suppressed'] )
		? sprintf( '  (%d suppressed by baseline)', $tally['suppressed'] )
		: '';
	$focus_note = ( $total_components > 0 && $shown_components < $total_components )
		? sprintf( "  (showing %d of %d components)\n", $shown_components, $total_components )
		: '';
	echo $focus_note;

	if ( 0 === $total ) {
		printf( "\n  ✓ Nothing blocks this upgrade.%s\n\n", $suppressed_note );
		return;
	}

	if ( 'table' === $format ) {
		render_table( $components, $collapse );
	} else {
		render_fix_first( $components, $root, $collapse );

		foreach ( $components as $c ) {
			$cnt   = component_counts( $c );
			$badge = component_badge( $cnt );
			printf( "\n  ▶ %s  —  %d finding%s%s\n", $c['label'], $c['count'], 1 === $c['count'] ? '' : 's', $badge );
			if ( 'summary' === $format ) {
				continue;
			}
			foreach ( $c['files'] as $rel => $findings ) {
				// Default view hides the long deprecation tail so the actionable
				// fatal/risky findings stay scannable; --all restores everything.
				if ( ! $show_all ) {
					$findings = array_values( array_filter( $findings, static fn( $f ) => in_array( $f['severity'], array( 'fatal', 'risky' ), true ) ) );
					if ( empty( $findings ) ) {
						continue; // Pure-deprecation file — only its component header shows.
					}
				}
				echo "      $rel\n";
				$rows = $collapse ? collapse_findings( $findings ) : array_map( static fn( $f ) => $f + array( 'lines' => array( $f['line'] ), 'count' => 1 ), $findings );
				foreach ( $rows as $f ) {
					$sev_badge = color_severity( sprintf( '%-7s', '[' . $f['severity'] . ']' ), $f['severity'] );
					$lines     = format_line_list( $f['lines'] );
					$xn        = $f['count'] > 1 ? sprintf( '  (×%d)', $f['count'] ) : '';
					printf( "        %s  %s %s%s\n", $lines, $sev_badge, compact_message( $f['message'] ), $xn );
				}
			}
		}
	}

	$bits = array();
	if ( $tally['fatal'] > 0 ) {
		$bits[] = ansi( sprintf( '%d fatal', $tally['fatal'] ), '1;31' );
	}
	if ( $tally['risky'] > 0 ) {
		$bits[] = ansi( sprintf( '%d risky', $tally['risky'] ), '1;33' );
	}
	$deprecations = $tally['php'] + $tally['wp'];
	if ( $deprecations > 0 ) {
		$bits[] = sprintf( '%d deprecation%s', $deprecations, 1 === $deprecations ? '' : 's' );
	}

	if ( $fatals > 0 ) {
		$verdict = ansi( '  ✗ Upgrade will break — fix fatals first.', '1;31' );
	} elseif ( $tally['risky'] > 0 ) {
		$verdict = ansi( '  ⚠ No fatals, but review the risky behaviour changes before upgrading.', '1;33' );
	} else {
		$verdict = ansi( '  ✓ No fatals — safe to upgrade; clear deprecations at leisure.', '0;32' );
	}

	printf(
		"\n  %s across %d component%s.%s%s\n",
		implode( ', ', $bits ),
		count( $components ),
		1 === count( $components ) ? '' : 's',
		$verdict,
		$suppressed_note
	);

	// Nudge toward the full listing when deprecations were hidden from the
	// default view (grouped only — summary never lists findings anyway).
	if ( ! $show_all && $deprecations > 0 && 'summary' !== $format ) {
		printf(
			"%s\n",
			ansi( sprintf( '  ↳ %d deprecation%s hidden — run with --all to list them.', $deprecations, 1 === $deprecations ? '' : 's' ), '0;90' )
		);
	}
	echo "\n";
}

/**
 * Per-component severity counts for the component header badge.
 *
 * @param array $c One grouped component (has 'files').
 * @return array{fatal:int,risky:int,dep:int}
 */
function component_counts( array $c ): array {
	$n = array( 'fatal' => 0, 'risky' => 0, 'dep' => 0 );
	foreach ( $c['files'] as $findings ) {
		foreach ( $findings as $f ) {
			if ( 'fatal' === $f['severity'] ) {
				++$n['fatal'];
			} elseif ( 'risky' === $f['severity'] ) {
				++$n['risky'];
			} else {
				++$n['dep'];
			}
		}
	}
	return $n;
}

/**
 * Build the coloured "(4 fatal, 3 risky, 184 deprecations)" component badge.
 *
 * @param array{fatal:int,risky:int,dep:int} $cnt Per-component counts.
 * @return string Badge with a leading separator, or '' when empty.
 */
function component_badge( array $cnt ): string {
	$bits = array();
	if ( $cnt['fatal'] > 0 ) {
		$bits[] = ansi( sprintf( '%d fatal', $cnt['fatal'] ), '1;31' );
	}
	if ( $cnt['risky'] > 0 ) {
		$bits[] = ansi( sprintf( '%d risky', $cnt['risky'] ), '1;33' );
	}
	if ( $cnt['dep'] > 0 ) {
		$bits[] = sprintf( '%d deprecation%s', $cnt['dep'], 1 === $cnt['dep'] ? '' : 's' );
	}
	return empty( $bits ) ? '' : '  (' . implode( ', ', $bits ) . ')';
}

/**
 * Shorten a sniff message for the compact listing.
 *
 * @param string $message Full sniff message.
 * @return string
 */
function compact_message( string $message ): string {
	// WP-side phrasing.
	$message = preg_replace( '/ is removed since WordPress /', ' — removed WP ', $message );
	$message = preg_replace( '/ is deprecated since WordPress /', ' — deprecated WP ', $message );
	// PHP-side phrasing.
	$message = preg_replace( '/ is deprecated since PHP .*? and removed since PHP /', ' — removed PHP ', $message );
	$message = preg_replace( '/ is deprecated since PHP /', ' — deprecated PHP ', $message );
	// Collapse the "; Use X instead." / ". Use X instead." replacement clause to "→ X".
	$message = preg_replace( '/[;.]?\s*Use (.+?)( instead)?\.?$/', ' → $1', $message );
	return rtrim( $message, '.;' );
}

/**
 * Collapse repeated identical findings within one file's finding list.
 *
 * Groups by (severity, message); each returned entry carries the original
 * fields plus `lines` (every line it occurred on, ascending) and `count`.
 * Large scans repeat the same sniff many times in one file — collapsing turns
 * a wall of identical lines into one line with an occurrence count.
 *
 * @param array $findings Findings for a single file.
 * @return array<int,array> Collapsed findings, fatal-first then by first line.
 */
function collapse_findings( array $findings ): array {
	$groups = array();
	foreach ( $findings as $f ) {
		// Group by line-neutralised message so near-identical findings that only
		// differ by an embedded line number (e.g. PHPCompatibility's func_get_args
		// "changed on line N") collapse together.
		$neutral = neutralize_lines( $f['message'] );
		$key     = $f['severity'] . '|' . $neutral;
		if ( ! isset( $groups[ $key ] ) ) {
			$groups[ $key ]            = $f;
			$groups[ $key ]['message'] = $neutral;
			$groups[ $key ]['lines']   = array();
			$groups[ $key ]['count']   = 0;
		}
		$groups[ $key ]['lines'][] = $f['line'];
		++$groups[ $key ]['count'];
	}
	foreach ( $groups as &$g ) {
		sort( $g['lines'], SORT_NUMERIC );
	}
	unset( $g );
	return array_values( $groups );
}

/**
 * Neutralise embedded line numbers in a sniff message ("line 554" → "line N")
 * so otherwise-identical findings collapse into one group. Mirrors the
 * normalisation used by baseline_signature().
 *
 * @param string $message Sniff message.
 * @return string
 */
function neutralize_lines( string $message ): string {
	return (string) preg_replace( '/\bline \d+/', 'line N', $message );
}

/**
 * Format a list of line numbers for the compact listing, capping the visible
 * count so a finding on 200 lines doesn't print 200 numbers.
 *
 * @param array $lines Line numbers (ascending).
 * @return string e.g. "560" or "560, 666, 1025, … +4".
 */
function format_line_list( array $lines ): string {
	if ( count( $lines ) <= 5 ) {
		return implode( ', ', $lines );
	}
	$head = array_slice( $lines, 0, 5 );
	return implode( ', ', $head ) . ', … +' . ( count( $lines ) - 5 );
}

/**
 * Determine the process exit code from the tally and --fail-on.
 *
 * --fail-on=fatal  → non-zero only when the upgrade would truly break (a removed
 *                    PHP symbol). Behavioural "risky" findings do not trip it.
 * --fail-on=risky  → non-zero on fatals or risky behavioural changes.
 * --fail-on=deprecated (alias any/warning) → non-zero on any finding.
 *
 * @param array $tally Severity tally.
 * @param array $opts  Parsed options.
 * @return int
 */
function exit_code( array $tally, array $opts ): int {
	$fail_on = $opts['fail-on'] ?? '';
	if ( '' === $fail_on ) {
		return 0;
	}
	if ( 'fatal' === $fail_on && $tally['fatal'] > 0 ) {
		return 1;
	}
	if ( 'risky' === $fail_on && ( $tally['fatal'] + $tally['risky'] ) > 0 ) {
		return 1;
	}
	if ( in_array( $fail_on, array( 'deprecated', 'any', 'warning' ), true ) && $tally['total'] > 0 ) {
		return 1;
	}
	return 0;
}

/**
 * Run phpcs in the background and animate a spinner on stderr until it finishes.
 *
 * phpcs's own -p meter only shows on a real TTY and is swallowed by any pipe, so
 * pressready drives its own indicator instead: it spawns phpcs via proc_open
 * (stdout discarded — the report goes to --report-json; stderr captured to
 * $errfile so a crash is still reportable) and ticks a braille spinner with
 * elapsed seconds while polling proc_get_status().
 *
 * @param string $cmd     Full phpcs shell command.
 * @param string $errfile Path to capture phpcs stderr into.
 */
function run_with_spinner( string $cmd, string $errfile ): void {
	$descriptors = array(
		0 => STDIN,
		1 => array( 'file', '/dev/null', 'w' ),
		2 => array( 'file', $errfile, 'w' ),
	);
	$pipes = array();
	$proc  = proc_open( $cmd, $descriptors, $pipes );
	if ( ! is_resource( $proc ) ) {
		return;
	}

	$frames = array( '⠋', '⠙', '⠹', '⠸', '⠼', '⠴', '⠦', '⠧', '⠇', '⠏' );
	$start  = microtime( true );
	$i      = 0;
	while ( proc_get_status( $proc )['running'] ) {
		$elapsed = (int) ( microtime( true ) - $start );
		fprintf( STDERR, "\r  %s  scanning… %ds ", $frames[ $i % count( $frames ) ], $elapsed );
		++$i;
		usleep( 100000 ); // 100ms tick.
	}
	proc_close( $proc );
	fwrite( STDERR, "\r\033[K" ); // Wipe the spinner line before the report prints.
}

/**
 * Resolve the WordPress deprecations dataset path. PRESSREADY_DATASET overrides
 * the bundled dataset (and is forwarded to the sniff), so the version check and
 * the scan agree on which dataset is in use.
 *
 * @param string $pkg This package's root.
 * @return string
 */
function dataset_path( string $pkg ): string {
	$env = getenv( 'PRESSREADY_DATASET' );
	if ( false !== $env && '' !== $env && is_file( $env ) ) {
		return $env;
	}
	return $pkg . '/data/wp-deprecations.json';
}

/**
 * Warn (to stderr) when the requested --wp target is newer than the WordPress
 * version the dataset was generated from, so a stale dataset can't masquerade as
 * a clean WP-side result. Compared on major.minor, so a pre-release source tag
 * (e.g. "7.1-alpha-62161-src") matches the "7.1" target it represents.
 *
 * @param string $wp   Target WP version.
 * @param string $path Dataset file path.
 * @return void
 */
function warn_if_dataset_stale( string $wp, string $path ): void {
	if ( ! is_file( $path ) ) {
		return;
	}
	$data = json_decode( (string) file_get_contents( $path ), true );
	$src  = $data['source']['wp_version'] ?? '';
	$mm   = static fn( string $v ): string => preg_match( '/^(\d+(?:\.\d+)?)/', $v, $m ) ? $m[1] : '';
	$have = $mm( (string) $src );
	$want = $mm( $wp );
	if ( '' !== $have && '' !== $want && version_compare( $want, $have, '>' ) ) {
		fwrite(
			STDERR,
			sprintf(
				"warning: --wp %s is newer than this dataset (WordPress %s); WP-side results may be incomplete — regenerate the dataset.\n",
				$wp,
				$have
			)
		);
	}
}

/**
 * Locate the PHP_CodeSniffer binary, whether this package is run from the
 * extracted phar bundle, standalone (its own vendor/), or installed as a
 * dependency (the consumer's vendor/bin).
 *
 * @param string|null $home Extracted phar home, or null when not running from a phar.
 * @return string|null Absolute path to phpcs, or null if not found.
 */
function find_phpcs( ?string $home = null ): ?string {
	$candidates = array();
	if ( null !== $home ) {
		$candidates[] = $home . '/vendor/bin/phpcs'; // Phar: bundled toolchain, extracted.
	}
	$candidates[] = dirname( __DIR__ ) . '/vendor/bin/phpcs'; // Standalone: package is the project root.
	$candidates[] = dirname( __DIR__, 3 ) . '/bin/phpcs';     // Installed: vendor/itzmekhokan/pressready/bin → vendor/bin.
	foreach ( $candidates as $path ) {
		if ( is_file( $path ) ) {
			return $path;
		}
	}
	return null;
}

/**
 * When running from the distributable .phar, extract the bundled toolchain
 * (phpcs + standards + dataset) to a per-version cache dir once and return it;
 * otherwise return null. phpcs runs as a subprocess over real files, which a
 * phar:// path cannot provide (phpcs's sniff discovery uses glob(), unsupported
 * on the phar stream), so self-extraction is how the single-file build stays
 * conflict-free yet runnable.
 *
 * @return string|null Absolute path to the extracted home, or null when not in a phar.
 */
function phar_runtime_dir(): ?string {
	$phar = Phar::running( false );
	if ( '' === $phar ) {
		return null;
	}
	// Key the cache by the phar's identity so a new build re-extracts cleanly,
	// without hashing the whole archive on every run.
	$key      = substr( md5( $phar . '|' . (string) @filemtime( $phar ) . '|' . (string) @filesize( $phar ) ), 0, 12 );
	$home     = sys_get_temp_dir() . '/pressready-phar-' . $key;
	$sentinel = $home . '/.pressready-extracted';
	if ( ! is_file( $sentinel ) ) {
		( new Phar( $phar ) )->extractTo( $home, null, true );
		@touch( $sentinel );
	}
	return $home;
}

/**
 * Map an --ignore-on level to the set of severity strings to suppress.
 *
 * Threshold model: 'deprecated' hides php+wp; 'risky' hides risky+deprecated;
 * 'fatal' hides everything. Mirrors the opposite direction of --fail-on.
 *
 * @param string $level 'fatal', 'risky', 'deprecated' (or aliases); empty → no-op.
 * @return string[]
 */
function ignore_severities( string $level ): array {
	switch ( $level ) {
		case 'fatal':
			return array( 'fatal', 'risky', 'php', 'wp' );
		case 'risky':
			return array( 'risky', 'php', 'wp' );
		case 'deprecated':
		case 'any':
		case 'warning':
			return array( 'php', 'wp' );
		default:
			return array();
	}
}

/**
 * Remove findings of ignored severities from the raw PHPCS data structure.
 *
 * Applied before regroup/tally so all output paths (grouped, table, json,
 * github) consistently omit ignored findings.
 *
 * @param array  $data  PHPCS JSON report.
 * @param string $level --ignore-on level (empty string → returns $data unchanged).
 * @return array
 */
function filter_data_ignored( array $data, string $level ): array {
	$drop = ignore_severities( $level );
	if ( empty( $drop ) ) {
		return $data;
	}
	foreach ( $data['files'] as &$info ) {
		if ( empty( $info['messages'] ) ) {
			continue;
		}
		$info['messages'] = array_values(
			array_filter(
				$info['messages'],
				static fn( $m ) => ! in_array( severity_of( $m ), $drop, true )
			)
		);
		$info['errors']   = count( array_filter( $info['messages'], static fn( $m ) => 'ERROR' === $m['type'] ) );
		$info['warnings'] = count( $info['messages'] ) - $info['errors'];
	}
	unset( $info );
	return $data;
}

/**
 * Return true when ANSI colour output should be written to STDOUT.
 *
 * Respects the NO_COLOR env spec (set to any value → off) and TERM=dumb.
 * Override with PRESSREADY_COLOR=1 (force on) or PRESSREADY_COLOR=0 (force off).
 *
 * @return bool
 */
function should_colorize(): bool {
	static $v = null;
	if ( null !== $v ) {
		return $v;
	}
	$override = getenv( 'PRESSREADY_COLOR' );
	if ( '1' === $override ) {
		return $v = true;
	}
	if ( '0' === $override ) {
		return $v = false;
	}
	if ( false !== getenv( 'NO_COLOR' ) ) {
		return $v = false;
	}
	if ( 'dumb' === getenv( 'TERM' ) ) {
		return $v = false;
	}
	return $v = ( function_exists( 'posix_isatty' ) && posix_isatty( STDOUT ) );
}

/**
 * Wrap $text in ANSI SGR codes when colourisation is active; otherwise a no-op.
 *
 * @param string $text Content to wrap.
 * @param string $code SGR parameter string, e.g. '1;31' for bold-red.
 * @return string
 */
function ansi( string $text, string $code ): string {
	return should_colorize() ? "\033[{$code}m{$text}\033[0m" : $text;
}

/**
 * Colorise a severity label that has already been padded to its final display width.
 *
 * Padding before colorising ensures ANSI bytes don't shift column alignment.
 *
 * @param string $label Padded label string (e.g. '[fatal]  ').
 * @param string $sev   Severity key: 'fatal', 'risky', 'php', 'wp'.
 * @return string
 */
function color_severity( string $label, string $sev ): string {
	static $codes = array(
		'fatal' => '1;31', // bold red
		'risky' => '1;33', // bold yellow
		'php'   => '0;36', // cyan
		'wp'    => '0;36', // cyan
	);
	$code = $codes[ $sev ] ?? '';
	return '' === $code ? $label : ansi( $label, $code );
}

/**
 * Split a string into lines of at most $width visible characters, breaking at
 * word boundaries where possible.
 *
 * @param string $text  Input text.
 * @param int    $width Maximum line width.
 * @return string[]
 */
function word_wrap_lines( string $text, int $width ): array {
	if ( strlen( $text ) <= $width ) {
		return array( $text );
	}
	$lines = array();
	while ( strlen( $text ) > $width ) {
		$chunk = substr( $text, 0, $width );
		$pos   = strrpos( $chunk, ' ' );
		if ( false === $pos || $pos < (int) ( $width / 4 ) ) {
			$pos = $width; // hard break when no usable space found
		}
		$lines[] = substr( $text, 0, $pos );
		$text    = ltrim( substr( $text, $pos ) );
	}
	if ( '' !== $text ) {
		$lines[] = $text;
	}
	return $lines;
}

/**
 * Truncate a string to $len characters, appending '...' if truncated.
 *
 * @param string $s   Input string.
 * @param int    $len Maximum length.
 * @return string
 */
function truncate_str( string $s, int $len ): string {
	if ( strlen( $s ) <= $len ) {
		return $s;
	}
	return substr( $s, 0, max( 0, $len - 3 ) ) . '...';
}

/**
 * Render findings as a WP-CLI-style ASCII table (used by --format=table).
 *
 * Rows are sorted fatal-first, then risky, then deprecations. The message
 * column word-wraps within the terminal width; other columns truncate with
 * '...' when content exceeds their cap. The shared verdict printed by
 * render() follows immediately after this function returns.
 *
 * @param array $components Grouped components (each with 'label' + 'files').
 * @param bool  $collapse   Collapse identical (component+severity+message) rows.
 */
function render_table( array $components, bool $collapse = true ): void {
	$order = array( 'fatal' => 0, 'risky' => 1, 'php' => 2, 'wp' => 3 );
	$rows  = array();
	foreach ( $components as $c ) {
		foreach ( $c['files'] as $rel => $findings ) {
			$list = $collapse ? collapse_findings( $findings ) : array_map( static fn( $f ) => $f + array( 'lines' => array( $f['line'] ), 'count' => 1 ), $findings );
			foreach ( $list as $f ) {
				$first = ( $rel . ':' . $f['lines'][0] );
				$more  = $f['count'] > 1 ? sprintf( ' (+%d more)', $f['count'] - 1 ) : '';
				$rows[] = array(
					'severity'  => $f['severity'],
					'component' => $c['label'],
					'location'  => $first . $more,
					'message'   => $f['message'],
					'_sort'     => $order[ $f['severity'] ] ?? 9,
				);
			}
		}
	}
	if ( empty( $rows ) ) {
		return;
	}
	usort( $rows, static fn( $a, $b ) => $a['_sort'] <=> $b['_sort'] );

	// Terminal width (fall back to 120 when tput is unavailable or piped).
	$term_w = 120;
	$tput   = trim( (string) shell_exec( 'tput cols 2>/dev/null' ) );
	if ( '' !== $tput && (int) $tput > 40 ) {
		$term_w = (int) $tput;
	}

	// Column widths: content-driven with hard caps; header labels set the minimum.
	$col_sev = max( 8, min( 12, max( array_map( static fn( $r ) => strlen( $r['severity'] ), $rows ) ) ) );
	$col_cmp = max( 9, min( 25, max( array_map( static fn( $r ) => strlen( $r['component'] ), $rows ) ) ) );
	$col_loc = max( 8, min( 40, max( array_map( static fn( $r ) => strlen( $r['location'] ), $rows ) ) ) );
	// Overhead per row: "| " + " | " + " | " + " | " + " |" = 13 chars.
	$col_msg = max( 20, $term_w - $col_sev - $col_cmp - $col_loc - 13 );

	$sep = sprintf(
		'+%s+%s+%s+%s+',
		str_repeat( '-', $col_sev + 2 ),
		str_repeat( '-', $col_cmp + 2 ),
		str_repeat( '-', $col_loc + 2 ),
		str_repeat( '-', $col_msg + 2 )
	);

	echo "\n" . $sep . "\n";
	printf( "| %-{$col_sev}s | %-{$col_cmp}s | %-{$col_loc}s | %-{$col_msg}s |\n",
		'severity', 'component', 'location', 'message' );
	echo $sep . "\n";

	$blank_sev = str_repeat( ' ', $col_sev );
	$blank_cmp = str_repeat( ' ', $col_cmp );
	$blank_loc = str_repeat( ' ', $col_loc );

	foreach ( $rows as $row ) {
		$sev_raw   = $row['severity'];
		$msg_lines = word_wrap_lines( $row['message'], $col_msg );

		// Pad to final width first, then colorize — ANSI bytes must not affect alignment.
		$sev_str = color_severity( str_pad( $sev_raw, $col_sev ), $sev_raw );
		$cmp_str = str_pad( truncate_str( $row['component'], $col_cmp ), $col_cmp );
		$loc_str = str_pad( truncate_str( $row['location'], $col_loc ), $col_loc );

		printf( "| %s | %s | %s | %-{$col_msg}s |\n",
			$sev_str, $cmp_str, $loc_str, $msg_lines[0] );

		for ( $i = 1, $n = count( $msg_lines ); $i < $n; $i++ ) {
			printf( "| %s | %s | %s | %-{$col_msg}s |\n",
				$blank_sev, $blank_cmp, $blank_loc, $msg_lines[ $i ] );
		}
	}

	echo $sep . "\n";
}

/**
 * Parse `--key=value` and bare `--flag` options.
 *
 * @param string[] $argv CLI arguments.
 * @return array<string,string>
 */
function parse_opts( array $argv ): array {
	$opts  = array();
	$paths = array();
	foreach ( array_slice( $argv, 1 ) as $arg ) {
		if ( preg_match( '/^--([a-z0-9_-]+)=(.*)$/i', $arg, $m ) ) {
			if ( 'path' === $m[1] ) {
				$paths[] = $m[2]; // Accumulate repeated --path rather than overwrite.
			}
			$opts[ $m[1] ] = $m[2];
		} elseif ( preg_match( '/^--([a-z0-9_-]+)$/i', $arg, $m ) ) {
			$opts[ $m[1] ] = '1';
		}
	}
	if ( count( $paths ) > 1 ) {
		$opts['path'] = $paths; // Multiple --path: hand the full list to resolve_scan_paths().
	}
	return $opts;
}

/**
 * Overlay a `.pressready.json` config under the CLI options.
 *
 * Precedence: CLI flag > config file > built-in default. The config path is
 * --config=<file> if given, else `.pressready.json` in the cwd when present.
 * Recognised keys mirror the flags; an `ignore` array is joined to a comma
 * list, and boolean `true` maps to the bare-flag value '1'.
 *
 * @param array<string,string> $cli Options parsed from argv (these win).
 * @return array<string,string>
 */
function apply_config( array $cli ): array {
	$path = $cli['config'] ?? '';
	if ( '' === $path ) {
		$default = getcwd() . '/.pressready.json';
		if ( ! is_file( $default ) ) {
			return $cli;
		}
		$path = $default;
	}
	if ( ! is_file( $path ) ) {
		fwrite( STDERR, "error: config not found: $path\n" );
		exit( 2 );
	}
	$config = json_decode( (string) file_get_contents( $path ), true );
	if ( ! is_array( $config ) ) {
		fwrite( STDERR, "error: config is not valid JSON: $path\n" );
		exit( 2 );
	}

	$allowed = array(
		'php', 'wp', 'since', 'path', 'paths', 'format', 'fail-on', 'ignore-on',
		'parallel', 'cache', 'ignore', 'only', 'top', 'baseline',
		'no-default-ignore', 'no-collapse', 'no-cache', 'all', 'matrix',
	);

	// Warn (don't fail) on unrecognised keys so a typo'd key — which would
	// silently change the scan scope — is visible instead of a no-op.
	foreach ( array_keys( $config ) as $key ) {
		if ( ! in_array( $key, $allowed, true ) ) {
			fwrite( STDERR, "warning: unknown key '$key' in $path (ignored)\n" );
		}
	}

	// CLI paths win wholesale over config paths (don't merge the two sources).
	if ( isset( $cli['path'] ) || isset( $cli['paths'] ) ) {
		unset( $config['path'], $config['paths'] );
	}

	foreach ( $allowed as $key ) {
		if ( isset( $cli[ $key ] ) || ! array_key_exists( $key, $config ) ) {
			continue; // CLI wins; skip keys the config doesn't set.
		}
		$value = $config[ $key ];
		if ( is_bool( $value ) ) {
			if ( $value ) {
				$cli[ $key ] = '1';
			}
		} elseif ( is_array( $value ) ) {
			$cli[ $key ] = implode( ',', $value );
		} else {
			$cli[ $key ] = (string) $value;
		}
	}
	return $cli;
}

/**
 * Resolve the phpcs `--parallel` worker count.
 *
 * Parallelism needs ext-pcntl (absent on Windows). ON by default at the CPU
 * core count; --parallel=N overrides, --parallel=1 disables.
 *
 * @param array<string,string> $opts Merged options.
 * @return int Worker count (1 = serial).
 */
function resolve_parallel( array $opts ): int {
	if ( ! extension_loaded( 'pcntl' ) ) {
		return 1;
	}
	// Explicit --parallel=N (including =1 to disable). Absent → auto by default.
	if ( isset( $opts['parallel'] ) ) {
		return max( 1, (int) $opts['parallel'] );
	}
	return detect_cpu_count();
}

/**
 * Best-effort CPU core count for the default parallel worker pool.
 *
 * @return int Core count (>= 1), capped to a sane upper bound; 4 on fallback.
 */
function detect_cpu_count(): int {
	$n = 0;
	if ( function_exists( 'shell_exec' ) ) {
		$out = trim( (string) ( shell_exec( 'nproc 2>/dev/null' ) ?: shell_exec( 'sysctl -n hw.ncpu 2>/dev/null' ) ) );
		if ( ctype_digit( $out ) ) {
			$n = (int) $out;
		}
	}
	if ( $n < 1 ) {
		$n = 4; // Reasonable default when detection fails.
	}
	return min( $n, 16 ); // Diminishing returns past this; keep memory sane.
}

/**
 * Build the comma-separated phpcs `--ignore` pattern list.
 *
 * Sensible built-in excludes (un-fixable vendored / generated / minified / test
 * code) are always on unless --no-default-ignore is given; user --ignore
 * patterns are appended.
 *
 * @param array<string,string> $opts Merged options.
 * @return string Comma list, or '' when nothing to ignore.
 */
function build_ignore_patterns( array $opts ): string {
	$patterns = array();
	if ( ! isset( $opts['no-default-ignore'] ) ) {
		// *.blade.php are scanned by phpcs (the extension ends in .php) but hold no
		// PHP — skipping them keeps Blade/Sage themes clean out of the box (Twig is
		// not a .php extension, so it is never scanned in the first place).
		$patterns = array( '*/vendor/*', '*/node_modules/*', '*/build/*', '*/dist/*', '*.min.php', '*/tests/*', '*.blade.php' );
	}
	if ( isset( $opts['ignore'] ) && '' !== $opts['ignore'] && '1' !== $opts['ignore'] ) {
		foreach ( explode( ',', $opts['ignore'] ) as $p ) {
			$p = trim( $p );
			if ( '' !== $p ) {
				$patterns[] = $p;
			}
		}
	}
	return implode( ',', $patterns );
}
